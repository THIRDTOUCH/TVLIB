  "shortcuts": [
    {
      "name": "新建项目",
      "short_name": "新建",
      "description": "创建一个新的剧本项目",
      "url": "./index.html?action=new",
      "icons": [
        { "src": "icons/icon-96.svg", "sizes": "96x96" }
      ]
    },
    {
      "name": "打开分镜",
      "short_name": "分镜",
      "description": "快速切换到分镜设计视图",
      "url": "./index.html?tab=storyboard",
      "icons": [
        { "src": "icons/icon-96.svg", "sizes": "96x96" }
      ]
    }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "application/json": [".json"]
      },
      "icons": [
        { "src": "icons/icon-96.svg", "sizes": "96x96" }
      ],
      "launch_type": "single-client"
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+dramaworkshop",
      "url": "./?project=%s"
    }
  ],
  "prefer_related_applications": false
}
